{
  "name": "flatspec-drive",
  "version": "1.0.0",
  "description": "FlatSpec Drive - 專案設計與執行系統",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "bundle:android": "node ./scripts/bundle_android.js",
